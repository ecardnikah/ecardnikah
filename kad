/* =====================================================
   RSVP
===================================================== */

async function submitRSVP(){

    const nameElement =
        document.getElementById("guestName");

    const attendanceElement =
        document.querySelector(
            'input[name="attendance"]:checked'
        );

    const paxElement =
        document.getElementById("guestPax");

    const messageElement =
        document.getElementById("guestMessage");

    const button =
        document.getElementById("submitRSVP");

    const status =
        document.getElementById("rsvpStatus");


    /* GET VALUES */

    const name =
        nameElement.value.trim();

    const attendance =
        attendanceElement
        ? attendanceElement.value
        : "Hadir";

    const pax =
        parseInt(paxElement.value) || 1;

    const message =
        messageElement.value.trim();


    /* VALIDATION */

    if(!name){

        status.innerHTML =
            "Sila masukkan nama.";

        nameElement.focus();

        return;
    }


    /* LOADING */

    button.disabled = true;

    button.innerHTML =
        "MENGHANTAR...";

    status.innerHTML = "";


    try{

        const { data, error } =
            await supabaseClient
            .from("rsvps")
            .insert({
                name: name,
                attendance: attendance,
                pax: pax,
                message: message
            })
            .select();


        /* DATABASE ERROR */

        if(error){

            console.error(
                "SUPABASE ERROR:",
                error
            );

            status.innerHTML =
                "❌ RSVP gagal dihantar. Sila cuba lagi.";

            button.disabled = false;

            button.innerHTML =
                "HANTAR RSVP";

            return;
        }


        /* SUCCESS */

        console.log(
            "RSVP berjaya disimpan:",
            data
        );


        status.innerHTML =
            "✓ RSVP berjaya dihantar. Terima kasih!";


        /* CLEAR FORM */

        nameElement.value = "";

        messageElement.value = "";


        /* RESET BUTTON */

        button.disabled = false;

        button.innerHTML =
            "HANTAR RSVP";


        /* REFRESH GUESTBOOK */

        await loadMessages();


    }

    catch(error){

        console.error(
            "RSVP ERROR:",
            error
        );

        status.innerHTML =
            "❌ Ralat berlaku. Sila cuba lagi.";

        button.disabled = false;

        button.innerHTML =
            "HANTAR RSVP";
    }

}


/* =====================================================
   LOAD GUEST MESSAGES
===================================================== */

async function loadMessages(){

    /* 
       PENTING:
       HTML kita guna id="messagesList"
    */

    const messages =
        document.getElementById(
            "messagesList"
        );


    /* SAFETY CHECK */

    if(!messages){

        console.error(
            "Element #messagesList tidak dijumpai."
        );

        return;
    }


    messages.innerHTML =
        `
        <div class="message-card">
            <div class="message-name">
                Memuatkan ucapan...
            </div>
        </div>
        `;


    try{

        const { data, error } =
            await supabaseClient
            .from("rsvps")
            .select(
                "name, attendance, pax, message, created_at"
            )
            .eq(
                "attendance",
                "Hadir"
            )
            .not(
                "message",
                "is",
                null
            )
            .order(
                "created_at",
                {
                    ascending:false
                }
            );


        /* DATABASE ERROR */

        if(error){

            console.error(
                "LOAD MESSAGE ERROR:",
                error
            );

            messages.innerHTML =
                `
                <div class="message-card">

                    <div class="message-name">
                        Ucapan belum dapat dimuatkan.
                    </div>

                    <div class="message-text">
                        Sila refresh halaman dan cuba lagi.
                    </div>

                </div>
                `;

            return;
        }


        /* NO MESSAGE */

        if(
            !data ||
            data.length === 0
        ){

            messages.innerHTML =
                `
                <div class="message-card">

                    <div class="message-name">
                        Belum ada ucapan 🤍
                    </div>

                    <div class="message-text">
                        Jadilah yang pertama meninggalkan
                        ucapan buat Mizi & Aina.
                    </div>

                </div>
                `;

            return;
        }


        /* DISPLAY MESSAGES */

        messages.innerHTML =
            data
            .map(function(item){

                const safeName =
                    escapeHTML(
                        item.name || ""
                    );


                const safeMessage =
                    escapeHTML(
                        item.message || ""
                    );


                const safePax =
                    Number(item.pax) || 1;


                return `

                    <div class="message-card">

                        <div class="message-name">
                            ${safeName}
                        </div>

                        <div class="message-pax">
                            HADIR · ${safePax} ORANG
                        </div>

                        <div class="message-text">
                            “${safeMessage}”
                        </div>

                    </div>

                `;

            })
            .join("");


    }

    catch(error){

        console.error(
            "UNEXPECTED LOAD ERROR:",
            error
        );

        messages.innerHTML =
            `
            <div class="message-card">

                <div class="message-name">
                    Ucapan belum dapat dimuatkan.
                </div>

            </div>
            `;
    }

}


/* =====================================================
   SECURITY
===================================================== */

function escapeHTML(text){

    return String(text)

        .replace(
            /&/g,
            "&amp;"
        )

        .replace(
            /</g,
            "&lt;"
        )

        .replace(
            />/g,
            "&gt;"
        )

        .replace(
            /"/g,
            "&quot;"
        )

        .replace(
            /'/g,
            "&#039;"
        );

}


