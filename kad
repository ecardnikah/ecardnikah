<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Mizi & Aina</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>

/* =====================================================
   RESET
===================================================== */

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:"DM Sans",sans-serif;
    background:#f7f1ea;
    color:#342d28;
}

body.no-scroll{
    overflow:hidden;
}

button{
    font-family:inherit;
    cursor:pointer;
}

a{l
    text-decoration:none;
    color:inherit;
}


/* =====================================================
   PREMIUM ENVELOPE
===================================================== */

#envelope.floral-envelope {
    position: fixed;
    inset: 0;

    width: 100%;
    height: 100vh;
    height: 100dvh;

    z-index: 99999;

    overflow: hidden;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #aab397;

    opacity: 1;
    visibility: visible;

    transition:
        opacity 1s ease,
        visibility 1s ease;
}


/* =========================================
   FLORAL BACKGROUND
========================================= */

.floral-design {
    position: relative;

    width: 100%;
    height: 100%;

    overflow: hidden;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    background:
        radial-gradient(
            ellipse at 20% 20%,
            rgba(255,255,255,.20),
            transparent 45%
        ),
        radial-gradient(
            ellipse at 80% 75%,
            rgba(70,83,52,.18),
            transparent 50%
        ),
        linear-gradient(
            135deg,
            #c4cbb0,
            #aab397 45%,
            #c3c9af
        );
}


/* =========================================
   FLORAL TEXTURE OVERLAY

   Tambah imej corak bunga pada fail
   sage-floral.jpg untuk hasil lebih realistik.
========================================= */

.floral-design::before {
    content: "";

    position: absolute;
    inset: 0;

    background-image:
        url("sage-floral.jpg");

    background-size: cover;
    background-position: center;

    opacity: .85;

    pointer-events: none;
}


/* =========================================
   PAPER GRAIN
========================================= */

.floral-design::after {
    content: "";

    position: absolute;
    inset: 0;

    z-index: 1;

    pointer-events: none;

    opacity: .22;

    background:
        repeating-linear-gradient(
            0deg,
            rgba(50,60,38,.08) 0px,
            rgba(50,60,38,.08) 1px,
            transparent 1px,
            transparent 4px
        ),
        linear-gradient(
            120deg,
            transparent 20%,
            rgba(255,255,255,.18) 50%,
            transparent 75%
        );
}


/* =========================================
   RIBBON
========================================= */

.ribbon {
    position: absolute;

    z-index: 2;

    pointer-events: none;

    background:
        linear-gradient(
            90deg,
            #d9dfb5 0%,
            #edf0d1 28%,
            #dce3b9 55%,
            #c5cda0 100%
        );

    box-shadow:
        inset 0 1px 2px rgba(255,255,255,.55),
        0 2px 5px rgba(40,50,25,.08);
}


/* RIBBON VERTICAL */

.ribbon-vertical {
    top: 0;
    bottom: 0;

    left: 50%;

    width: 15%;

    transform: translateX(-50%);
}


/* RIBBON HORIZONTAL */

.ribbon-horizontal {
    left: 0;
    right: 0;

    top: 43%;

    height: 8%;
}


/* =========================================
   RED WAX SEAL
========================================= */

.floral-wax {
    position: absolute;

    z-index: 5;

    top: 46%;
    left: 50%;

    width: clamp(105px, 30vw, 145px);
    aspect-ratio: 1;

    transform: translate(-50%, -50%);

    border-radius: 50%;

    border: 5px solid #a83c32;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    color: #f9b2a0;

    background:
        radial-gradient(
            circle at 32% 25%,
            #ff9180 0%,
            #dc493d 30%,
            #bc3029 62%,
            #7d201d 100%
        );

    box-shadow:
        0 8px 14px rgba(65,30,22,.30),
        inset 0 3px 5px rgba(255,205,190,.55),
        inset 0 -7px 10px rgba(80,10,10,.28);

    transition:
        transform .45s ease,
        opacity .45s ease;
}


/* WAX OUTER RIM */

.floral-wax::before {
    content: "";

    position: absolute;

    inset: 9px;

    border-radius: 50%;

    border: 2px solid rgba(100,20,18,.45);

    box-shadow:
        inset 0 1px 2px rgba(255,200,185,.45);
}


/* WAX INNER CIRCLE */

.floral-wax::after {
    content: "";

    position: absolute;

    inset: 16px;

    border-radius: 50%;

    border: 1px solid rgba(255,180,160,.38);
}


/* INITIALS */

.wax-initials {
    position: relative;

    z-index: 2;

    display: flex;
    align-items: center;

    font-family:
        "Cormorant Garamond",
        Georgia,
        serif;

    font-size: clamp(22px, 6vw, 31px);

    font-style: italic;

    text-shadow:
        0 1px 2px rgba(90,15,12,.5);
}

.wax-initials span {
    font-size: .6em;

    margin: 0 3px;
}


/* =========================================
   INVITATION TEXT
========================================= */

.invitation-title {
    position: absolute;

    z-index: 4;

    top: 57%;

    width: 100%;

    text-align: center;

    color: #20251a;

    font-family:
        "Great Vibes",
        "Brush Script MT",
        cursive;

    font-size: clamp(35px, 10vw, 52px);

    transform: rotate(-7deg);

    text-shadow:
        0 1px 1px rgba(255,255,255,.25);
}


.invitation-subtitle {
    position: absolute;

    z-index: 4;

    top: 65%;

    width: 100%;

    text-align: center;

    font-family:
        "DM Sans",
        sans-serif;

    font-size: 9px;

    letter-spacing: 3px;

    color: #414735;
}


.invitation-date {
    position: absolute;

    z-index: 4;

    top: 69%;

    width: 100%;

    text-align: center;

    font-family:
        "DM Sans",
        sans-serif;

    font-size: 10px;

    letter-spacing: 4px;

    color: #414735;
}


/* =========================================
   TAP INSTRUCTION
========================================= */

.invitation-tap {
    position: absolute;

    z-index: 4;

    bottom: max(45px, env(safe-area-inset-bottom));

    width: 100%;

    text-align: center;

    font-family:
        "DM Sans",
        sans-serif;

    font-size: 9px;

    letter-spacing: 3px;

    color: #454c38;

    animation: invitationPulse 2s infinite;
}


@keyframes invitationPulse {
    0%, 100% {
        opacity: .45;
    }

    50% {
        opacity: 1;
    }
}


/* =========================================
   OPEN ANIMATION
========================================= */

#envelope.floral-envelope.opening .floral-wax {
    transform:
        translate(-50%, -50%)
        scale(.65)
        rotate(-12deg);

    opacity: 0;
}

#envelope.floral-envelope.opening .floral-design {
    transform: scale(1.04);

    transition: transform 1.8s ease;
}

#envelope.floral-envelope.hide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}


/* =========================================
   SMALL SCREENS
========================================= */

@media (max-width: 380px) {
    .ribbon-vertical {
        width: 17%;
    }

    .invitation-title {
        top: 57%;
    }

    .invitation-subtitle {
        font-size: 8px;
        letter-spacing: 2px;
    }
}


/* =====================================================
   GENERAL
===================================================== */

.container{
    width:92%;
    max-width:1050px;
    margin:auto;
}

section{
    padding:90px 0;
}

.eyebrow{
    font-size:11px;
    letter-spacing:.2em;
    text-transform:uppercase;
    color:#8a796c;
}

.section-title{
    text-align:center;
    margin-bottom:45px;
}

.section-title h2{
    font-family:"Cormorant Garamond",serif;
    font-size:65px;
    font-weight:500;
    line-height:1;
}


/* =====================================================
   HERO
===================================================== */

.hero{
    min-height:100vh;

    display:flex;
    justify-content:center;
    align-items:center;

    text-align:center;

    position:relative;

    overflow:hidden;

    background:
        radial-gradient(
            circle at 50% 40%,
            #fffdf9 0%,
            #f7f1ea 55%,
            #eee3d7 100%
        );
}

.hero::before{
    content:"";

    position:absolute;

    width:420px;
    height:420px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(180,150,125,.12),
            transparent 70%
        );

    top:50%;
    left:50%;

    transform:
        translate(-50%,-50%);

    pointer-events:none;
}

.hero .container{
    position:relative;
    z-index:2;
}

.hero .eyebrow{
    opacity:.75;

    animation:
        heroFade 1.2s ease .3s both;
}

.hero h1{
    font-family:"Cormorant Garamond",serif;

    font-size:
        clamp(78px,15vw,150px);

    font-weight:500;

    line-height:.68;

    letter-spacing:-.03em;

    color:#3d342e;

    margin-top:28px;

    animation:
        heroTitle 1.3s cubic-bezier(.2,.7,.2,1) .45s both;
}

.hero .amp{
    display:block;

    font-family:"Cormorant Garamond",serif;

    font-size:.45em;

    font-weight:400;

    color:#a08369;

    margin:20px 0;
}

.hero-date{
    margin-top:45px;

    font-size:11px;

    letter-spacing:.35em;

    color:#76675d;

    animation:
        heroFade 1.2s ease 1s both;
}

.scroll{
    margin-top:65px;

    color:#9a897c;

    font-size:9px;

    letter-spacing:.3em;

    animation:
        scrollFade 2s ease 1.5s infinite;
}

@keyframes heroFade{

    from{
        opacity:0;
        transform:translateY(15px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

@keyframes heroTitle{

    from{
        opacity:0;

        transform:
            translateY(35px)
            scale(.96);
    }

    to{
        opacity:1;

        transform:
            translateY(0)
            scale(1);
    }

}

@keyframes scrollFade{

    0%,100%{
        opacity:.3;
        transform:translateY(0);
    }

    50%{
        opacity:1;
        transform:translateY(8px);
    }

}


/* =====================================================
   INTRO
===================================================== */

.intro-section{
    min-height:80vh;

    display:flex;
    align-items:center;
    justify-content:center;

    text-align:center;

    padding:100px 25px;

    background:#fffdf9;

    position:relative;

    overflow:hidden;
}

.intro-section::before{
    content:"";

    position:absolute;

    width:500px;
    height:500px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(170,140,115,.08),
            transparent 70%
        );

    top:50%;
    left:50%;

    transform:
        translate(-50%,-50%);

    pointer-events:none;
}

.intro-container{
    position:relative;

    z-index:2;

    max-width:650px;

    animation:
        introReveal 1.3s ease both;
}

.intro-ornament{
    font-size:18px;

    color:#a88c74;

    margin-bottom:30px;

    animation:
        ornamentFloat 3s ease-in-out infinite;
}

.intro-ornament.bottom{
    margin-top:35px;

    margin-bottom:0;

    font-size:13px;
}

.intro-arabic{
    font-family:
        "Cormorant Garamond",
        serif;

    font-size:28px;

    color:#4a4039;

    line-height:1.8;

    margin-bottom:28px;
}

.intro-line{
    width:45px;

    height:1px;

    background:#b9a28d;

    margin:
        0 auto 30px;
}

.intro-small{
    font-size:11px;

    letter-spacing:.18em;

    text-transform:uppercase;

    color:#9b8b7d;

    margin-bottom:25px;
}

.intro-text{
    font-family:
        "Cormorant Garamond",
        serif;

    font-size:23px;

    line-height:1.7;

    color:#62574f;

    margin:0 auto;

    max-width:520px;
}

.intro-names{
    font-family:
        "Cormorant Garamond",
        serif;

    font-size:38px;

    color:#403730;

    margin-top:35px;

    letter-spacing:.03em;
}

.intro-names span{
    font-size:25px;

    color:#a08369;

    margin:
        0 8px;
}


/* INTRO ANIMATION */

@keyframes introReveal{

    from{
        opacity:0;

        transform:
            translateY(35px);
    }

    to{
        opacity:1;

        transform:
            translateY(0);
    }

}

@keyframes ornamentFloat{

    0%,100%{
        transform:
            translateY(0);

        opacity:.6;
    }

    50%{
        transform:
            translateY(-6px);

        opacity:1;
    }

}


/* MOBILE INTRO */

@media(max-width:600px){

    .intro-section{
        min-height:75vh;

        padding:80px 25px;
    }

    .intro-arabic{
        font-size:24px;
    }

    .intro-small{
        font-size:9px;

        letter-spacing:.14em;
    }

    .intro-text{
        font-size:21px;
    }

    .intro-names{
        font-size:34px;
    }

}


/* =====================================================
   COUPLE
===================================================== */

.couple-section{
    background:#f7f1ea;

    position:relative;

    overflow:hidden;
}

.couple-intro{
    max-width:620px;

    margin:
        -15px auto 60px;

    text-align:center;

    color:#85776d;

    font-family:
        "Cormorant Garamond",
        serif;

    font-size:21px;

    line-height:1.7;
}

.couple{
    display:grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap:70px;

    max-width:850px;

    margin:auto;
}

.person{
    text-align:center;

    position:relative;

    animation:
        coupleReveal 1s ease both;
}

.person:nth-child(2){
    animation-delay:.2s;
}

.person-image{
    position:relative;

    width:100%;

    max-width:330px;

    margin:auto;
}

.person-image::before{
    content:"";

    position:absolute;

    inset:-10px;

    border:
        1px solid #cbb6a2;

    border-radius:
        180px 180px 20px 20px;

    z-index:0;

    transform:
        rotate(2deg);
}

.person-image::after{
    content:"";

    position:absolute;

    width:12px;
    height:12px;

    border-radius:50%;

    background:#a88c74;

    top:25px;

    right:5px;

    z-index:3;
}

.person img{
    position:relative;

    z-index:2;

    display:block;

    width:100%;

    aspect-ratio:4/5;

    object-fit:cover;

    border-radius:
        180px 180px 12px 12px;

    box-shadow:
        0 20px 45px
        rgba(70,50,35,.12);

    transition:
        transform .6s ease;
}

.person:hover img{
    transform:
        translateY(-8px);
}

.person h3{
    font-family:
        "Cormorant Garamond",
        serif;

    font-size:46px;

    font-weight:500;

    color:#403730;

    margin-top:30px;

    line-height:1;
}

.person p{
    color:#927f70;

    font-size:10px;

    letter-spacing:.22em;

    text-transform:uppercase;

    margin-top:10px;
}

.couple-and{
    position:absolute;

    left:50%;

    top:48%;

    transform:
        translate(-50%,-50%);

    width:55px;

    height:55px;

    border-radius:50%;

    background:#fffdf9;

    border:
        1px solid #d7c6b6;

    display:flex;

    align-items:center;

    justify-content:center;

    font-family:
        "Cormorant Garamond",
        serif;

    font-size:25px;

    color:#a08369;

    z-index:5;

    box-shadow:
        0 8px 25px
        rgba(60,40,30,.08);
}


@keyframes coupleReveal{

    from{
        opacity:0;

        transform:
            translateY(35px);
    }

    to{
        opacity:1;

        transform:
            translateY(0);
    }

}


/* MOBILE */

@media(max-width:700px){

    .couple{
        grid-template-columns:1fr;

        gap:65px;
    }

    .couple-intro{
        font-size:20px;

        padding:0 15px;
    }

    .person-image{
        max-width:280px;
    }

    .person h3{
        font-size:40px;
    }

    .couple-and{
        position:relative;

        left:auto;
        top:auto;

        transform:none;

        margin:
            -25px auto -25px;
    }

}


/* =====================================================
   COUNTDOWN
===================================================== */

.countdown-section{
    position:relative;

    overflow:hidden;

    background:
        radial-gradient(
            circle at center,
            #55463b 0%,
            #392f28 65%,
            #2e2621 100%
        );

    color:#fffdf9;

    text-align:center;

    padding:120px 0;
}

.countdown-section::before{
    content:"";

    position:absolute;

    width:500px;
    height:500px;

    border:1px solid rgba(255,255,255,.08);

    border-radius:50%;

    top:50%;
    left:50%;

    transform:
        translate(-50%,-50%);
}

.countdown-section::after{
    content:"";

    position:absolute;

    width:350px;
    height:350px;

    border:1px solid rgba(255,255,255,.05);

    border-radius:50%;

    top:50%;
    left:50%;

    transform:
        translate(-50%,-50%);
}

.countdown-section .container{
    position:relative;

    z-index:2;
}

.countdown-section .eyebrow{
    color:#cbb9a7;

    letter-spacing:.3em;
}

.countdown-title{
    font-family:
        "Cormorant Garamond",
        serif;

    font-size:62px;

    font-weight:400;

    margin-top:20px;

    color:#fffdf9;
}

.countdown-date{
    margin-top:12px;

    font-size:10px;

    letter-spacing:.35em;

    color:#bca999;
}

.countdown{
    max-width:760px;

    margin:60px auto 0;

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:0;
}

.time{
    padding:15px 10px;

    border-right:
        1px solid
        rgba(255,255,255,.14);
}

.time:last-child{
    border-right:0;
}

.time strong{
    display:block;

    font-family:
        "Cormorant Garamond",
        serif;

    font-size:65px;

    font-weight:400;

    line-height:1;

    color:#fffdf9;
}

.time span{
    display:block;

    margin-top:12px;

    font-size:9px;

    letter-spacing:.25em;

    color:#bca999;
}

.countdown-note{
    margin-top:55px;

    font-family:
        "Cormorant Garamond",
        serif;

    font-size:19px;

    color:#cbb9a7;

    font-style:italic;
}


/* MOBILE */

@media(max-width:700px){

    .countdown-section{
        padding:90px 0;
    }

    .countdown-title{
        font-size:48px;
    }

    .countdown{
        margin-top:45px;
    }

    .time{
        padding:10px 4px;
    }

    .time strong{
        font-size:43px;
    }

    .time span{
        font-size:7px;

        letter-spacing:.15em;
    }

    .countdown-note{
        font-size:17px;

        padding:0 20px;
    }

}


/* =====================================================
   EVENT
===================================================== */

.event-section{
    background:#fffdf9;
    position:relative;
    overflow:hidden;
}

.event-section::before{
    content:"";

    position:absolute;

    width:420px;
    height:420px;

    border:1px solid #eee3d8;

    border-radius:50%;

    top:50%;
    left:50%;

    transform:translate(-50%,-50%);

    pointer-events:none;
}

.event-section .container{
    position:relative;
    z-index:2;
}

.event-card{
    max-width:780px;

    margin:auto;

    background:#f7f1ea;

    padding:55px 35px;

    text-align:center;

    border:1px solid #e3d5c7;

    box-shadow:
        0 25px 60px
        rgba(70,50,35,.08);
}

.event-date-big{
    font-family:
        "Cormorant Garamond",
        serif;

    font-size:58px;

    font-weight:500;

    color:#403730;

    line-height:1;
}

.event-day{
    margin-top:12px;

    font-size:10px;

    letter-spacing:.3em;

    color:#9b8878;

    text-transform:uppercase;
}

.event-divider{
    width:45px;

    height:1px;

    background:#b9a18d;

    margin:35px auto;
}

.event-details{
    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:0;
}

.event-item{
    padding:10px 20px;

    border-right:
        1px solid #d9cabc;
}

.event-item:last-child{
    border-right:0;
}

.event-icon{
    font-size:20px;

    color:#a08369;

    margin-bottom:12px;
}

.event-label{
    font-size:9px;

    letter-spacing:.25em;

    color:#9b8878;

    text-transform:uppercase;
}

.event-value{
    margin-top:8px;

    font-family:
        "Cormorant Garamond",
        serif;

    font-size:22px;

    color:#4b4038;
}

.event-venue{
    margin-top:40px;

    padding-top:30px;

    border-top:
        1px solid #d9cabc;
}

.event-venue-name{
    font-family:
        "Cormorant Garamond",
        serif;

    font-size:32px;

    color:#403730;
}

.event-address{
